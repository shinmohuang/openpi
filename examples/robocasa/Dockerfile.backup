# Dockerfile for running a RoboCasa client to query an OpenPI policy server.

# Build the container:
# docker build -f examples/robocasa/Dockerfile -t openpi-robocasa:latest .

# Run the container (connects to server at host network):
# docker run --rm -it --network=host --gpus all -v .:/app openpi-robocasa:latest /bin/bash

FROM nvidia/cuda:12.2.2-cudnn8-runtime-ubuntu22.04@sha256:2d913b09e6be8387e1a10976933642c73c840c0b735f0bf3c28d97fc9bc422e0
COPY --from=ghcr.io/astral-sh/uv:0.5.1 /uv /uvx /bin/

ARG INSTALL_APT_DEPS=0
RUN if [ "$INSTALL_APT_DEPS" = "1" ]; then \
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    git make g++ clang libosmesa6-dev libgl1-mesa-glx libglew-dev libglfw3-dev libgles2-mesa-dev libglib2.0-0 libsm6 libxrender1 libxext6 && \
    rm -rf /var/lib/apt/lists/*; \
    else \
    echo "Skipping apt deps (INSTALL_APT_DEPS=0)"; \
    fi

WORKDIR /app

# Copy from the cache instead of linking since it's a mounted volume
ENV UV_LINK_MODE=copy

# Write the virtual environment outside of the project directory so it doesn't
# leak out of the container when we mount the application code.
ENV UV_PROJECT_ENVIRONMENT=/.venv

# Use OSMesa for headless rendering by default
ENV MUJOCO_GL=osmesa

# Bring local third_party sources into the image (expected to exist in repo)
COPY ./third_party/robosuite /third_party/robosuite
COPY ./third_party/robocasa /third_party/robocasa

# Copy requirements for base libs and openpi-client pyproject
COPY ./examples/robocasa/requirements.txt /tmp/requirements.txt
COPY ./packages/openpi-client/pyproject.toml /tmp/openpi-client/pyproject.toml
ENV UV_CACHE_DIR=/var/cache/uv

# Create Python 3.10 virtual environment (RoboCasa stack is Py3.10-friendly)
RUN uv venv --python 3.10 $UV_PROJECT_ENVIRONMENT

# Install base python dependencies (cache-busted via ARG)
ARG DEPS_BUST=2024-10-16
RUN --mount=type=cache,target=/var/cache/uv \
    set -eux; \
    echo "deps bust: $DEPS_BUST"; \
    /.venv/bin/python -m ensurepip --upgrade; \
    /.venv/bin/python -m pip install --no-cache-dir -U pip setuptools wheel; \
    /.venv/bin/python -m pip install --no-cache-dir -r /tmp/requirements.txt

# Clean uv cache separately; ignore failures safely
RUN uv --python /.venv/bin/python cache clean -a || true

# Verify numpy import (should be provided by requirements.txt)
RUN /.venv/bin/python -c "import numpy as np; print('numpy', np.__version__)"

# Install robosuite and robocasa from local sources (editable installs)
RUN /.venv/bin/python -m pip install --no-cache-dir -e /third_party/robosuite -e /third_party/robocasa && \
    uv --python /.venv/bin/python cache clean -a || true

# Make local sources importable even if editable metadata is unavailable
ENV PYTHONPATH=/third_party/robosuite:/third_party/robocasa:/app:/app/packages/openpi-client/src

# Set up macros without importing robocasa at build-time
RUN set -eux; \
    MACROS_SRC=/third_party/robocasa/robocasa/macros.py; \
    MACROS_DST=/third_party/robocasa/robocasa/macros_private.py; \
    if [ -f "$MACROS_SRC" ]; then cp -f "$MACROS_SRC" "$MACROS_DST"; fi

# Default command: drop into shell. You can run the client like:
# python examples/simple_client/main.py --env robocasa --host <server-ip> --port 8000
CMD ["/bin/bash"]
